<p style="color: green"><%= notice %></p>

<% content_for :title, "Departamentos" %>

  <h1>Departamentos</h1>

<table class="table table-bordered table-hover">
  <tbody>
    <div id="departamentos">
      <% @departamentos.each do |departamento| %>
        <td><%= render departamento %></td>
        <p>
          <td><%= link_to "Mostrar este departamento", departamento %></td>
        </p>
      <% end %>
    </div>
  </tbody>

 <td> <%= link_to "Novo departamento", new_departamento_path %></td>
</table>
