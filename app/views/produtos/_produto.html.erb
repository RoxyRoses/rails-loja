<tr>
    <td><%= produto.nome%></td>
    <td><%= produto.descricao%></td>
    <td><%= produto.departamento.nome%></td>
    <td><%= produto.preco%></td>
    <td><%= produto.quantidade%></td>
    <td><%= link_to "Alterar", edit_produto_path(produto), class: "btn btn-default" %></td>
    <td><%= button_to "Remover", produto, method: :delete, data: {turbo_method: :delete, turbo_confirm: "Tem certeza que deseja remover o #{produto.nome}?"}, class: "btn btn-danger"  %></td>
</tr>